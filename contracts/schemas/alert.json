{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracehawk.local/schemas/alert.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "alert_id",
    "scope_id",
    "run_id",
    "detector_id",
    "rule_version",
    "indicator_version",
    "severity",
    "status",
    "suppressed",
    "suppression_id",
    "source_ip",
    "destination_ip",
    "first_event_time_us",
    "last_event_time_us",
    "window_start_us",
    "window_end_us",
    "episode_bucket_start_us",
    "created_at_us",
    "updated_at_us",
    "explanation",
    "explanation_version",
    "observed",
    "thresholds",
    "evidence_event_ids",
    "evidence_total_count",
    "evidence_truncated"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "alert_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "detector_id": {
      "enum": [
        "vertical_tcp_scan",
        "failed_tcp_connections",
        "dns_nxdomain_burst",
        "known_indicator"
      ]
    },
    "rule_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "indicator_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "status": {
      "enum": [
        "open",
        "acknowledged",
        "resolved"
      ]
    },
    "suppressed": {
      "type": "boolean"
    },
    "suppression_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "source_ip": {
      "anyOf": [
        {
          "type": "string",
          "format": "ipv4"
        },
        {
          "type": "string",
          "format": "ipv6"
        }
      ]
    },
    "destination_ip": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "format": "ipv4"
            },
            {
              "type": "string",
              "format": "ipv6"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "first_event_time_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "last_event_time_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "window_start_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "window_end_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "episode_bucket_start_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "created_at_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updated_at_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "explanation_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "observed": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "enum": [
          "distinct_ports",
          "attempts",
          "failure_ratio",
          "completed_responses",
          "nxdomain_ratio",
          "indicator_matches"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "thresholds": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string",
            "maxLength": 128
          }
        ]
      }
    },
    "evidence_event_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "evidence_total_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "evidence_truncated": {
      "type": "boolean"
    }
  }
}
