{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracehawk.local/schemas/event.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "scope_id",
    "sensor_id",
    "run_id",
    "event_kind",
    "event_time_us",
    "original_timestamp_us",
    "ingested_at_us",
    "published_at_us",
    "time_basis",
    "source_ip",
    "destination_ip",
    "source_port",
    "destination_port",
    "protocol",
    "zeek_uid",
    "provenance",
    "connection",
    "dns"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sensor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "event_kind": {
      "enum": [
        "connection",
        "dns"
      ]
    },
    "event_time_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "original_timestamp_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ingested_at_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "published_at_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "time_basis": {
      "enum": [
        "connection_activity_end",
        "original_start_fallback",
        "dns_transaction_start"
      ]
    },
    "source_ip": {
      "anyOf": [
        {
          "type": "string",
          "format": "ipv4"
        },
        {
          "type": "string",
          "format": "ipv6"
        }
      ]
    },
    "destination_ip": {
      "anyOf": [
        {
          "type": "string",
          "format": "ipv4"
        },
        {
          "type": "string",
          "format": "ipv6"
        }
      ]
    },
    "source_port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "destination_port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "protocol": {
      "enum": [
        "tcp",
        "udp"
      ]
    },
    "zeek_uid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "log_kind",
        "source_generation_id",
        "record_offset",
        "zeek_version",
        "capture_id",
        "input_mode"
      ],
      "properties": {
        "log_kind": {
          "enum": [
            "conn",
            "dns"
          ]
        },
        "source_generation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "record_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "zeek_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "capture_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "input_mode": {
          "enum": [
            "controlled_pcap",
            "public_pcap",
            "zeek_fixture",
            "synthetic_fixture"
          ]
        }
      }
    },
    "connection": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "duration_us",
            "orig_bytes",
            "resp_bytes",
            "missed_bytes"
          ],
          "properties": {
            "state": {
              "anyOf": [
                {
                  "enum": [
                    "S0",
                    "S1",
                    "SF",
                    "REJ",
                    "S2",
                    "S3",
                    "RSTO",
                    "RSTR",
                    "RSTOS0",
                    "RSTRH",
                    "SH",
                    "SHR",
                    "OTH"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "duration_us": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "orig_bytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "resp_bytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "missed_bytes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "dns": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query",
            "rcode",
            "rcode_name",
            "qtype",
            "trans_id",
            "answers"
          ],
          "properties": {
            "query": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                },
                {
                  "type": "null"
                }
              ]
            },
            "rcode": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4095
                },
                {
                  "type": "null"
                }
              ]
            },
            "rcode_name": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                {
                  "type": "null"
                }
              ]
            },
            "qtype": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                {
                  "type": "null"
                }
              ]
            },
            "trans_id": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                {
                  "type": "null"
                }
              ]
            },
            "answers": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_kind": {
            "const": "connection"
          }
        }
      },
      "then": {
        "properties": {
          "connection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "duration_us",
              "orig_bytes",
              "resp_bytes",
              "missed_bytes"
            ],
            "properties": {
              "state": {
                "anyOf": [
                  {
                    "enum": [
                      "S0",
                      "S1",
                      "SF",
                      "REJ",
                      "S2",
                      "S3",
                      "RSTO",
                      "RSTR",
                      "RSTOS0",
                      "RSTRH",
                      "SH",
                      "SHR",
                      "OTH"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "duration_us": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "orig_bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "resp_bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "missed_bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "dns": {
            "type": "null"
          },
          "provenance": {
            "properties": {
              "log_kind": {
                "const": "conn"
              }
            }
          },
          "time_basis": {
            "enum": [
              "connection_activity_end",
              "original_start_fallback"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "dns": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "query",
              "rcode",
              "rcode_name",
              "qtype",
              "trans_id",
              "answers"
            ],
            "properties": {
              "query": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rcode": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4095
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rcode_name": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "qtype": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "trans_id": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "answers": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              }
            }
          },
          "connection": {
            "type": "null"
          },
          "time_basis": {
            "const": "dns_transaction_start"
          },
          "provenance": {
            "properties": {
              "log_kind": {
                "const": "dns"
              }
            }
          }
        }
      }
    }
  ]
}
