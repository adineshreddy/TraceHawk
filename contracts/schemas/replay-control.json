{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracehawk.local/schemas/replay-control.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "control_kind",
    "scope_id",
    "run_id",
    "producer_generation",
    "partition",
    "last_data_offset",
    "final_watermark_us",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "control_kind": {
      "const": "replay_partition_complete"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "producer_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "partition": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "last_data_offset": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "final_watermark_us": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
