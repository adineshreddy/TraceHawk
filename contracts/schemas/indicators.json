{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracehawk.local/schemas/indicators.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "provenance",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value",
          "description"
        ],
        "properties": {
          "kind": {
            "enum": [
              "ip",
              "domain"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
